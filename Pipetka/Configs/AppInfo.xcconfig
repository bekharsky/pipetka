// Application-level settings for the macOS target.

// The application's name.
PRODUCT_NAME = Pipetka

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.kharion.pipetka

// App Store version shown as CFBundleShortVersionString.
MARKETING_VERSION = 1.0.13

// Local fallback build number. Xcode Cloud overwrites this from CI_BUILD_NUMBER.
CURRENT_PROJECT_VERSION = 1

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Kharion. All rights reserved.
